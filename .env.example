# Copy to .env. Never commit real values.
# Local Docker: postgresql://shiftuplab:local_only_change_me@localhost:5433/shiftuplab?schema=app
# Neon production: use the owner/migration role for first boot (prisma migrate deploy). Append schema=app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/shiftuplab?sslmode=require&schema=app

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h

# Hardcoded admin login. Not stored in Git or the database.
ADMIN_EMAIL=admin@shiftuplab.com
ADMIN_PASSWORD=replace-with-at-least-12-characters

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,https://shiftuplab.com,https://www.shiftuplab.com,https://blogs.shiftuplab.com,https://careers.shiftuplab.com,https://admin.shiftuplab.com
PORT=4000
NODE_ENV=development
